# === Telegram Bot ===
# Token from @BotFather (required)
BOT_TOKEN=1234567890:AAReplaceMeWithYourRealToken

# === Database ===
# Local SQLite (default — just leave as is for local dev):
DATABASE_URL=sqlite+aiosqlite:///mafia.db
#
# On Render with PostgreSQL: do NOT set this manually. Render injects
# DATABASE_URL from the linked database service; the app converts
# "postgres://" to "postgresql+asyncpg://" at runtime.
#
# On Render with SQLite: mount a disk (see render.yaml) and keep the file
# on it, otherwise the database is recreated on every deploy:
#   DATABASE_URL=sqlite+aiosqlite:////var/data/mafia.db

# === Persistent storage ===
# Directory for the SQLite file and other state. Relative sqlite paths
# are anchored here, so DATA_DIR=/var/data is enough on Render.
DATA_DIR=

# === Web server (Render) ===
# Render injects PORT automatically. For local dev you can override:
PORT=8080

# === Optional ===
# Bot owners with full access to /admin (comma-separated Telegram ids).
# Get your id from @userinfobot. Leave empty to disable the admin panel.
ADMIN_IDS=
# Legacy single-owner setting, still honoured if ADMIN_IDS is empty.
ADMIN_ID=0
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
